+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#pragma once
+#include <stdint.h>
+#include <string.h>
+struct ItlReplayKey {
+    uint64_t pn[17]={};
+    uint32_t epoch=0;
+    bool installed=false;
+    void install(uint64_t rsc) { epoch++; installed=true; for (unsigned i=0;i<17;i++) pn[i]=rsc; }
+    void clear() { epoch++; installed=false; memset(pn,0,sizeof(pn)); }
+    bool accept(uint64_t value,uint8_t tid,uint32_t generation) {
+        if (!installed || tid>16 || generation!=epoch || !value || value>0xffffffffffffULL || value<=pn[tid]) return false;
+        pn[tid]=value; return true;
+    }
+};
diff --git a/src/itl_rsn.cpp b/src/itl_rsn.cpp
new file mode 100644
index 0000000..1ef32f6
--- /dev/null
+++ b/src/itl_rsn.cpp
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include "itl_rsn.h"
+#include <string.h>
+
+namespace {
+void wipe(void *memory,size_t length) {
+    volatile uint8_t *p=(volatile uint8_t *)memory;
+    while (length--) *p++=0;
+}
+uint16_t le16(const uint8_t *p) { return (uint16_t)(p[0]|p[1]<<8); }
+uint64_t rscValue(const uint8_t *p) {
+    uint64_t v=0; for (unsigned i=0;i<6;i++) v|=(uint64_t)p[i]<<(8*i); return v;
+}
+bool suite(const uint8_t *p, uint8_t type) { return p[0]==0 && p[1]==15 && p[2]==172 && p[3]==type; }
+bool supported(const uint8_t *ie, size_t length) {
+    if (!ie || length<20 || length>257 || ie[0]!=48 || ie[1]+2u!=length || le16(ie+2)!=1 || !suite(ie+4,4)) return false;
+    size_t off=8; bool ccmp=false, psk=false;
+    for (unsigned set=0;set<2;set++) {
+        if (off+2>length) return false;
+        unsigned count=le16(ie+off); off+=2;
+        if (!count || count>(length-off)/4) return false;
+        for (unsigned i=0;i<count;i++,off+=4) {
+            if (set==0 && suite(ie+off,4)) ccmp=true;
+            if (set==1 && suite(ie+off,2)) psk=true;
+        }
+    }
+    if (off==length) return ccmp && psk;
+    if (off+2>length || (le16(ie+off)&(1u<<6))) return false; // PMF required is unsupported.
+    off+=2;
+    if (off<length) {
+        if (off+2>length) return false;
+        unsigned count=le16(ie+off); off+=2;
+        if (count>(length-off)/16) return false;
+        off+=16*count;
+        if (off<length) { if (length-off!=4) return false; off+=4; }
+    }
+    return off==length && ccmp && psk;
+}
+}
+
+bool itl_rsn_select(const uint8_t *ap,size_t n,const uint8_t *request,size_t rn,ItlRsnSecurity *out) {
+    if (!out) return false;
+    memset(out,0,sizeof(*out));
+    if (!supported(ap,n) || (rn && !supported(request,rn))) return false;
+    static const uint8_t station[]={48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+    out->apLength=(uint16_t)n; memcpy(out->ap,ap,n);
+    out->stationLength=sizeof(station); memcpy(out->station,station,sizeof(station));
+    return true;
+}
+
+void ItlRsnSession::reset() {
+    // clear() owns hardware rollback; callers invoke it before resetting a live session.
+    wipe(pmk,sizeof(pmk)); wipe(&candidate,sizeof(candidate)); wipe(&active,sizeof(active));
+    wipe(gtk,sizeof(gtk)); memset(gtkInstalled,0,sizeof(gtkInstalled));
+    wipe(snonce,sizeof(snonce)); wipe(anonce,sizeof(anonce)); wipe(activeAnonce,sizeof(activeAnonce));
+    memset(pendingReplay,0,8); memset(acceptedReplay,0,8);
+    accepted=installed=pending=false; phase=Idle; failure="";
+}
+void ItlRsnSession::start(const ItlRsnOps &o,const ItlRsnSecurity &s,const uint8_t p[32],
+                          const uint8_t ap[6],const uint8_t station[6],uint32_t now) {
+    reset(); ops=o; security=s; memcpy(pmk,p,32); memcpy(aa,ap,6); memcpy(spa,station,6);
+    m1Count=m2Count=m3Count=groupCount=rejects=0; phase=AwaitM1; phaseStart=now; lastM2=now;
+}
+void ItlRsnSession::fail(const char *why) {
+    failure=why; phase=Failed; installed=false;
+    if (ops.clear) ops.clear(ops.context);
+    wipe(&candidate,sizeof(candidate)); wipe(&active,sizeof(active));
+    wipe(pmk,sizeof(pmk)); wipe(gtk,sizeof(gtk)); memset(gtkInstalled,0,sizeof(gtkInstalled));
+}
+bool ItlRsnSession::cancelled() {
+    if (ops.cancelled && ops.cancelled(ops.context)) { fail("session cancelled or AP disconnected"); return true; }
+    return false;
+}
+bool ItlRsnSession::sendM2(uint32_t now) {
+    uint8_t out[99+ITL_RSN_IE_MAX];
+    size_t n=itl_eapol_build(out,0x010a,0,pendingReplay,snonce,security.station,security.stationLength);
+    itl_eapol_mic(candidate.kck,out,n); m2Count++; lastM2=now;
+    return ops.send && ops.send(ops.context,out,n,false,false);
+}
+bool ItlRsnSession::sendReply(uint16_t info,const uint8_t replay[8],const uint8_t kck[16],bool protect) {
+    uint8_t out[99],zero[32]={}; size_t n=itl_eapol_build(out,info,0,replay,zero,nullptr,0);
+    itl_eapol_mic(kck,out,n);
+    return ops.send && ops.send(ops.context,out,n,protect,true);
+}
+bool ItlRsnSession::decodeData(const itl_eapol_key &k,const itl_ptk &ptk,bool pairwise,uint8_t key[16],uint8_t *id) {
+    if (!(k.info&ITL_KI_ENCRYPTED) || k.datalen<24 || k.datalen>ITL_RSN_FRAME_MAX-99 || k.datalen%8) return false;
+    uint8_t plain[ITL_RSN_FRAME_MAX];
+    if (itl_aes128_unwrap(ptk.kek,k.data,k.datalen,plain)) { wipe(plain,sizeof(plain)); return false; }
+    size_t size=k.datalen-8,off=0; bool rsn=false,found=false,valid=true;
+    while (off<size) {
+        // IEEE AES-wrap padding: 0xdd followed by zeroes, or a zero tail.
+        if ((plain[off]==221 && (off+1==size || plain[off+1]==0)) || plain[off]==0) {
+            size_t first=plain[off]==221?off+1:off;
+            for (size_t i=first;i<size;i++) if (plain[i]) valid=false;
+            break;
+        }
+        if (size-off<2 || plain[off+1]+2u>size-off) { valid=false; break; }
+        const uint8_t *e=plain+off; size_t n=e[1]+2u;
+        if (e[0]==48) {
+            if (rsn || n!=security.apLength || memcmp(e,security.ap,n)) { valid=false; break; }
+            rsn=true;
+        } else if (e[0]==221 && e[1]>=4 && suite(e+2,1)) {
+            if (found || e[1]!=22 || e[7]!=0 || (e[6]&0xf8)) { valid=false; break; }
+            *id=e[6]&3; memcpy(key,e+8,16); found=true;
+        }
+        off+=n;
+    }
+    wipe(plain,sizeof(plain)); return valid && found && (!pairwise || rsn);
+}
+
+bool ItlRsnSession::receive(const uint8_t *frame,size_t length,uint32_t now) {
+    if (phase==Idle || phase==Failed || cancelled()) return false;
+    itl_eapol_key k={};
+    if (length>ITL_RSN_FRAME_MAX || itl_eapol_parse(frame,length,&k) || frame[4]!=2 ||
+        (k.info&ITL_KI_VER_MASK)!=2 || !(k.info&ITL_KI_ACK) ||
+        (k.info&(ITL_KI_ERROR|ITL_KI_REQUEST|0xe030))) { rejects++; return false; }
+    bool pairwise=(k.info&ITL_KI_PAIRWISE)!=0;
+    if (pairwise && !(k.info&ITL_KI_MIC) && !(k.info&ITL_KI_INSTALL)) {
+        if (k.keylen!=16 || (k.info&(ITL_KI_SECURE|ITL_KI_ENCRYPTED)) || (accepted && memcmp(k.replay,acceptedReplay,8)<=0) ||
+            (pending && memcmp(k.replay,pendingReplay,8)<0) ||
+            (pending && !memcmp(k.replay,pendingReplay,8) && memcmp(k.nonce,anonce,32))) { rejects++; return false; }
+        bool changed=!pending || memcmp(anonce,k.nonce,32);
+        if (changed) {
+            if (!ops.random) { fail("no nonce source"); return false; }
+            ops.random(ops.context,snonce,32); memcpy(anonce,k.nonce,32);
+            itl_wpa_ptk(pmk,aa,spa,anonce,snonce,&candidate);
+        }
+        if (!pending) phaseStart=now;
+        pending=true; phase=AwaitM3; memcpy(pendingReplay,k.replay,8); m1Count++;
+        sendM2(now); return true; // enqueue pressure is retried by tick().
+    }
+    const itl_ptk *ptk=pairwise && pending?&candidate:&active;
+    if (!(k.info&ITL_KI_MIC) || !(k.info&ITL_KI_SECURE) || k.keylen!=16 ||
+        (pairwise && !(k.info&ITL_KI_INSTALL)) || (!pairwise && (!installed || pending || (k.info&ITL_KI_INSTALL))) ||
+        (pairwise && !pending && !installed) ||
+        (accepted && memcmp(k.replay,acceptedReplay,8)<0) ||
+        (pairwise && pending && memcmp(k.replay,pendingReplay,8)<=0) ||
+        (pairwise && memcmp(k.nonce,pending?anonce:activeAnonce,32)) ||
+        !itl_eapol_mic_ok(ptk->kck,frame,4u+((uint32_t)frame[2]<<8)+frame[3])) { rejects++; return false; }
+    uint8_t key[16]={},id=0;
+    if (!decodeData(k,*ptk,pairwise,key,&id)) { rejects++; wipe(key,16); return false; }
+    bool sameReplay=accepted && !memcmp(k.replay,acceptedReplay,8);
+    bool newPtk=pairwise && (!installed || memcmp(ptk->tk,active.tk,16));
+    bool newGtk=!gtkInstalled[id] || memcmp(key,gtk[id],16);
+    if (sameReplay && (lastPairwise!=pairwise || newPtk || newGtk)) { rejects++; wipe(key,16); return false; }
+    // M4 is transmitted before initial PTK installation; retransmits reuse installed keys.
+    if (pairwise && (!sendReply(0x030a,k.replay,ptk->kck,false) || cancelled())) {
+        if (phase!=Failed) fail("M4 transmission failed"); wipe(key,16); return false;
+    }
+    if (cancelled()) { wipe(key,16); return false; }
+    if ((newPtk && (!ops.install || !ops.install(ops.context,true,0,ptk->tk,0))) || cancelled() ||
+        (newGtk && (!ops.install || !ops.install(ops.context,false,id,key,rscValue(k.rsc)))) || cancelled()) {
+        if (phase!=Failed) fail("key transaction failed"); wipe(key,16); return false;
+    }
+    if (!pairwise && (!sendReply(0x0302,k.replay,ptk->kck,true) || cancelled())) {
+        if (phase!=Failed) fail("group reply transmission failed"); wipe(key,16); return false;
+    }
+    if (pairwise) {
+        active=*ptk; memcpy(activeAnonce,k.nonce,32); pending=false; installed=true; phase=Established; m3Count++;
+    } else groupCount++;
+    memcpy(gtk[id],key,16); gtkInstalled[id]=true; wipe(key,16);
+    memcpy(acceptedReplay,k.replay,8); accepted=true; lastPairwise=pairwise; return true;
+}
+void ItlRsnSession::tick(uint32_t now) {
+    if (phase==Idle || phase==Failed || cancelled()) return;
+    if ((phase==AwaitM1 || phase==AwaitM3) && (uint32_t)(now-phaseStart)>=6000) { fail("EAPOL deadline expired"); return; }
+    if (phase==AwaitM3 && (uint32_t)(now-lastM2)>=1500) sendM2(now);
+}
