+        bool same=d->txGen[slot]==(token>>8),done=d->txCompletedToken[slot]==token;
+        bool success=done && d->txCompletion[slot]==0;
+        IOLockUnlock(d->txLock);
+        if (done) return success && d->sessionCurrent();
+        if (!same) return false;
+        d->m3Pump(1);
+    }
+    d->setProperty("wifi-rsn-error","EAPOL TX completion missing or session cancelled");
+    return false;
+}
+bool itlmt7922::rsnInstall(void *ctx,bool pairwise,uint8_t id,const uint8_t *key,uint64_t rsc) {
+    auto *d=(itlmt7922 *)ctx;
+    if (!d->sessionCurrent() || id>3) return false;
+    // Drop/defer ordinary data while the firmware's key epoch is changing.
+    __atomic_store_n(&d->rsnKeyUpdate,true,__ATOMIC_RELEASE);
+    int rc=d->m3Key(pairwise?1:19,pairwise,id,key,16);
+    if (!rc && d->sessionCurrent()) {
+        // Buffered MPDUs retain their old epoch and will be rejected after reorder.
+        d->rxKeys[pairwise?0:1+id].install(rsc);
+    } else rc=-5;
+    __atomic_store_n(&d->rsnKeyUpdate,false,__ATOMIC_RELEASE);
+    return rc==0;
+}
+void itlmt7922::rsnClear(void *ctx) {
+    auto *d=(itlmt7922 *)ctx;
+    __atomic_store_n(&d->rsnKeyUpdate,true,__ATOMIC_RELEASE);
+    d->m3linkUp=false;
+    d->m3dataOn=false;
+    for (auto &key:d->rxKeys) key.clear();
+    if (d->rsnHardwareActive && !d->shouldStop() && !d->firmwareFault) {
+        d->rsnHardwareActive=false;
+        if (d->associationReady) {
+            uint8_t leave[26]={}; leave[0]=0xc0;
+            memcpy(leave+4,d->tgtBssid,6); memcpy(leave+10,d->mac,6); memcpy(leave+16,d->tgtBssid,6); leave[24]=3;
+            d->m3Tx(leave,sizeof(leave),0,12);
+            d->m3Pump(20);
+        }
+        int rc=d->m3Key(1,true,0,nullptr,0);
+        if (!rc) rc=d->m3Key(19,false,0,nullptr,0); // DEL_KEY removes this station record's cipher set.
+        if (!rc) rc=d->m3Sta(255,false,0);
+        if (!rc) rc=d->m3Bss(false);
+        if (rc) d->recoverWanted=true;
+    }
+    d->associationReady=false;
+    bzero(d->m3ptk,sizeof(d->m3ptk));
+    d->m3cipher=0;
+    __atomic_store_n(&d->rsnKeyUpdate,false,__ATOMIC_RELEASE);
+}
+bool itlmt7922::rxAccept(uint64_t pn,uint8_t key,uint8_t tid,uint32_t epoch) {
+    if (!m3linkUp || key>4 || !rxKeys[key].accept(pn,tid,epoch)) {
+        stRxDrop++; stRxCipherReject++; return false;
+    }
+    return true;
+}
+void itlmt7922::rsnService() {
+    while (m3EapolNext() && rsn.state()!=ItlRsnSession::Failed) rsn.receive(m3eapol,m3eapolLen,nowMs());
+    rsn.tick(nowMs());
+    if (rsn.state()==ItlRsnSession::Failed || nowMs()-rsnLastPublish>=500) {
+        rsnLastPublish=nowMs(); char status[160];
+        snprintf(status,sizeof(status),"state=%u m1=%u m2=%u m3=%u group=%u rejected=%u epoch=%u",
+                 (unsigned)rsn.state(),rsn.m1Count,rsn.m2Count,rsn.m3Count,rsn.groupCount,rsn.rejects,activeAttempt);
+        setProperty("wifi-handshake",status);
+    }
+    if (rsn.state()==ItlRsnSession::Failed) {
+        setProperty("wifi-rsn-error",rsn.error()); m3lost=true;
+        strlcpy(m3lostWhy,rsn.error(),sizeof(m3lostWhy));
+    }
+}
+int itlmt7922::m3Handshake() {
+    ItlRsnOps ops={this,rsnSend,rsnInstall,rsnClear,rsnCancelled,rsnRandom};
+    rsn.start(ops,rsnSecurity,m3pmk,tgtBssid,mac,nowMs());
+    rsnLastPublish=nowMs()-500;
+    removeProperty("wifi-rsn-error"); m3wantEapol=true;
+    while (rsn.state()!=ItlRsnSession::Established && rsn.state()!=ItlRsnSession::Failed && sessionCurrent()) {
+        m3Pump(1); rsnService();
+    }
+    if (!sessionCurrent() || !rsn.authorized()) {
+        rsnClear(this); rsn.reset(); return -5;
+    }
+    return 0;
+}
+
+void itlmt7922::publishSnapshot() {
+    if (!snapshotLock) return;
+    ItlNativeStatus s={}; buildNativeStatus(&s);
+    IOLockLock(snapshotLock);
+    statusSnapshot=s;
+    IOLockUnlock(snapshotLock);
+}
+void itlmt7922::nativeStatus(ItlNativeStatus *s) {
+    IOLockLock(cmdLock);
+    IOLockLock(snapshotLock); *s=statusSnapshot; IOLockUnlock(snapshotLock);
+    // Mailbox changes invalidate the entire previous session, not just its state.
+    uint32_t sequence=__atomic_load_n(&njSeq,__ATOMIC_ACQUIRE);
+    if (s->joinSeq!=sequence) {
+        bzero(s,sizeof(*s)); s->version=1; s->joinSeq=sequence;
+        s->state=__atomic_load_n(&njState,__ATOMIC_ACQUIRE);
+        if (s->state==ITL_NATIVE_UP) s->state=ITL_NATIVE_CONNECTING;
+    }
+    s->scanBusy=__atomic_load_n(&scanBusy,__ATOMIC_ACQUIRE);
+    IOLockUnlock(cmdLock);
+}
+void itlmt7922::nativeNets(ItlNativeNets *out) {
+    if (!out->aps) return;
+    IOLockLock(snapshotLock);
+    out->version=1; out->count=snapshotCount<out->max?snapshotCount:out->max;
+    out->scanGen=snapshotScanGen;
+    for (uint32_t i=0;i<out->count;i++) out->aps[i]=apSnapshots[i];
+    IOLockUnlock(snapshotLock);
+    out->scanBusy=__atomic_load_n(&scanBusy,__ATOMIC_ACQUIRE);
+}
