diff --git a/tests/station_test.cpp b/tests/station_test.cpp
new file mode 100644
index 0000000..cff5aad
--- /dev/null
+++ b/tests/station_test.cpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include "../src/itl_station.h"
+#include "../src/itl_caps.h"
+#include "../codec/mt7922_tx_codec.h"
+#include <assert.h>
+#include <stdio.h>
+static uint32_t le32(const uint8_t *p){return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+int main(){
+    // An HT-only AP may advertise OFDM only and omit every Basic bit.
+    const uint8_t nOnly[]={1,8,12,18,24,36,48,72,96,108};
+    ItlLegacyRates rates={};assert(itl_station_rates(nOnly,sizeof(nOnly),true,&rates));
+    assert(rates.cck==0 && rates.ofdm==255 && rates.basicOfdm==1 && rates.inferred);
+    uint8_t ies[32]={};size_t n=itl_station_rate_ies(ies,rates);
+    const uint8_t expected[]={1,8,0x8c,18,24,36,48,72,96,108};
+    assert(n==sizeof(expected) && !memcmp(ies,expected,n));
+    const uint8_t mixed[]={1,8,0x82,0x84,0x8b,0x96,12,18,24,36,50,4,48,72,96,108};
+    assert(itl_station_rates(mixed,sizeof(mixed),true,&rates) && !rates.inferred);
+    assert(rates.cck==15 && rates.basicCck==15 && itl_station_rate_ies(ies,rates)==16);
+    ItlLegacyRates round={};assert(itl_station_rates(ies,16,true,&round) && round.cck==15 && round.ofdm==255);
+    assert(itl_station_rates(mixed,sizeof(mixed),false,&rates) && !rates.cck && rates.basicOfdm);
+    for(size_t i=0;i<sizeof(nOnly);i++)assert(!itl_station_rates(nOnly,i,true,&rates));
+    const uint8_t wmm[]={221,7,0,0x50,0xf2,2,0,1,0};
+    itl_ap_caps caps={};itl_caps_parse(wmm,sizeof(wmm),&caps);assert(caps.wmm);
+    uint8_t invalid[sizeof(wmm)];memcpy(invalid,wmm,sizeof(wmm));invalid[7]=2;
+    itl_caps_parse(invalid,sizeof(invalid),&caps);assert(!caps.wmm);
+    invalid[7]=1;invalid[6]=1;itl_caps_parse(invalid,sizeof(invalid),&caps);assert(!caps.wmm); // truncated parameter IE
+    // DHCP broadcast is sent to the AP using the PTK and AC_BE; its final
+    // Ethernet destination does not turn the radio hop into a group/no-ACK TX.
+    const uint8_t ap[]={2,1,2,3,4,5},station[]={2,6,7,8,9,10},broadcast[]={255,255,255,255,255,255};
+    const uint8_t payload[]={0x45,0,0,4};uint8_t frame[1600],txwi[32];
+    for(unsigned ht=0;ht<2;ht++){
+        ItlDataTxPlan p=itl_station_data_tx(ht,ht,true,0x0800);assert(p.queue==1 && p.qos==(bool)ht);
+        n=itl_station_to_ds(frame,sizeof(frame),ap,station,broadcast,0x0800,payload,sizeof(payload),p.qos,true);
+        assert(n==(ht?38u:36u) && frame[1]==0x41 && !(frame[4]&1));
+        assert(!memcmp(frame+4,ap,6)&&!memcmp(frame+10,station,6)&&!memcmp(frame+16,broadcast,6));
+        assert(frame[ht?32:30]==8 && frame[ht?33:31]==0);
+        Mt7922TxOptions o={};o.wlan_index=1;o.queue=p.queue;o.protect=true;o.rate_adapt=p.rateAdapt;o.sequence=-1;o.fixed_rate=0x4b;
+        assert(mt7922_encode_txwi(txwi,frame,(uint32_t)n,o));
+        assert(le32(txwi)>>25==1 && (le32(txwi+12)&3)==2 && (le32(txwi+4)&1023)==1);
+    }
+    ItlDataTxPlan e=itl_station_data_tx(true,true,true,0x888e);assert(!e.qos&&!e.rateAdapt&&e.queue==16);
+    assert(!itl_station_to_ds(frame,20,ap,station,broadcast,0x0800,payload,4,false,true));
+    assert(!itl_station_to_ds(frame,sizeof(frame),ap,station,broadcast,0x0800,payload,1537,false,true));
+    puts("Station policy: OFDM-only/basic-rate recovery, WMM validation, DHCP To-DS/CCMP/WCID/AC_BE and legacy/HT paths passed.");
+}
