+// SPDX-License-Identifier: BSD-3-Clause-Clear
+// Tahoe WCL association fields, checked against AirportItlwm's published layout.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+struct Mt7902JoinRequest {
+    uint8_t ssidLength;
+    char ssid[33];
+    uint8_t pmk[32];
+    uint8_t bssid[6];
+    uint16_t channelSpec, rsnLength;
+    uint8_t rsn[257];
+};
+
+enum class Mt7902JoinResult { Ok, Invalid, Unsupported };
+
+static inline uint32_t mt7902JoinRead32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+        (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline Mt7902JoinResult mt7902DecodeJoin(const void *buffer, size_t length,
+                                              Mt7902JoinRequest *request)
+{
+    if (!request) return Mt7902JoinResult::Invalid;
+    memset(request, 0, sizeof(*request));
+    if (!buffer || length < 0x218) return Mt7902JoinResult::Invalid;
+    const uint8_t *p = static_cast<const uint8_t *>(buffer);
+    const uint32_t candidates = mt7902JoinRead32(p + 0x214);
+    const uint32_t ssidLength = mt7902JoinRead32(p + 0x1c);
+    const uint32_t keyLength = mt7902JoinRead32(p + 0x44);
+    const uint32_t cipher = mt7902JoinRead32(p + 0x48);
+    const uint32_t lowerAuth = mt7902JoinRead32(p + 0x10);
+    const uint32_t upperAuth = mt7902JoinRead32(p + 0x14);
+    const uint16_t rsnLength = (uint16_t)(p[0xd4] | p[0xd5]<<8);
+    if (!candidates || candidates > 10 || length < 0x218 + candidates * 18 ||
+        !ssidLength || ssidLength > 32 || keyLength > 32 || rsnLength>257) return Mt7902JoinResult::Invalid;
+    if (rsnLength && (rsnLength<4 || p[0xd6]!=48 || p[0xd7]+2u!=rsnLength || p[0xd8]!=1 || p[0xd9]!=0))
+        return Mt7902JoinResult::Invalid;
+    const uint8_t *bssid = p + 0x21c;
+    uint8_t addressBits = 0;
+    for (unsigned i = 0; i < 6; i++) addressBits |= bssid[i];
+    if (!addressBits || (bssid[0] & 1)) return Mt7902JoinResult::Invalid;
+    // WCL supplies a derived 32-byte PMK. Cipher 7 is PMKSA, cipher 9 is MSK.
+    // Negotiate WPA2-PSK even when the AP also advertises WPA or SHA256-PSK.
+    constexpr uint32_t personal = (1u << 1) | (1u << 3) | (1u << 10);
+    if (lowerAuth != 1 || !(upperAuth & (1u << 3)) || (upperAuth & ~personal) ||
+        keyLength != 32 || (cipher != 6 && cipher != 7)) return Mt7902JoinResult::Unsupported;
+    request->ssidLength = (uint8_t)ssidLength;
+    memcpy(request->ssid, p + 0x20, ssidLength);
+    memcpy(request->pmk, p + 0x50, sizeof(request->pmk));
+    memcpy(request->bssid, bssid, sizeof(request->bssid));
+    request->channelSpec=(uint16_t)(p[0x228] | p[0x229]<<8);
+    request->rsnLength=rsnLength; memcpy(request->rsn,p+0xd6,rsnLength);
+    return Mt7902JoinResult::Ok;
+}
