diff --git a/tests/native_join_test.cpp b/tests/native_join_test.cpp
new file mode 100644
index 0000000..333e321
--- /dev/null
+++ b/tests/native_join_test.cpp
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include "../kexts/itlmt7925Native/mt7902_join.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+static void check(bool passed, int line)
+{
+    if (passed) return;
+    fprintf(stderr, "Native join check failed at line %d\n", line);
+    exit(1);
+}
+#define CHECK(condition) check((condition), __LINE__)
+
+static void put32(uint8_t *p, uint32_t value)
+{
+    for (unsigned i = 0; i < 4; i++) p[i] = (uint8_t)(value >> (8 * i));
+}
+
+int main()
+{
+    uint8_t wire[0x2cc] = {};
+    put32(wire + 0x10, 1);
+    put32(wire + 0x14, 8);
+    put32(wire + 0x1c, 4);
+    memcpy(wire + 0x20, "test", 4);
+    put32(wire + 0x44, 32);
+    put32(wire + 0x48, 7);
+    for (unsigned i = 0; i < 32; i++) wire[0x50 + i] = (uint8_t)(i + 1);
+    put32(wire + 0x214, 1);
+    const uint8_t bssid[6] = {0x02, 0x10, 0x20, 0x30, 0x40, 0x50};
+    memcpy(wire + 0x21c, bssid, sizeof(bssid));
+    Mt7902JoinRequest request = {};
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Ok);
+    CHECK(request.ssidLength == 4 && !strcmp(request.ssid, "test"));
+    CHECK(!memcmp(request.pmk, wire + 0x50, 32));
+    CHECK(!memcmp(request.bssid, bssid, 6));
+    wire[0x21]=0; wire[0x22]='x';
+    CHECK(mt7902DecodeJoin(wire,sizeof(wire),&request)==Mt7902JoinResult::Ok);
+    CHECK(request.ssidLength==4 && request.ssid[1]==0 && request.ssid[2]=='x');
+    memcpy(wire+0x20,"test",4);
+
+    put32(wire + 0x48, 6);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Ok);
+    put32(wire + 0x48, 9);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Unsupported);
+    for (uint8_t byte : request.pmk) CHECK(byte == 0);
+    put32(wire + 0x48, 7);
+    put32(wire + 0x14, 8 | 2 | 1024);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Ok);
+    put32(wire + 0x14, 4);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Unsupported);
+    put32(wire + 0x14, 8);
+    put32(wire + 0x44, 31);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Unsupported);
+    put32(wire + 0x44, 33);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    put32(wire + 0x44, 32);
+    put32(wire + 0x1c, 32);
+    memset(wire + 0x20, 's', 32);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Ok);
+    CHECK(request.ssid[32] == 0);
+    put32(wire + 0x1c, 33);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    put32(wire + 0x1c, 4);
+    for (size_t length = 0; length < 0x22a; length++)
+        CHECK(mt7902DecodeJoin(wire, length, &request) == Mt7902JoinResult::Invalid);
+    put32(wire + 0x214, 10);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Ok);
+    put32(wire + 0x214, 11);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    put32(wire + 0x214, 0);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    put32(wire + 0x214, 1);
+    memset(wire + 0x21c, 0, 6);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    wire[0x21c] = 1;
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), &request) == Mt7902JoinResult::Invalid);
+    CHECK(mt7902DecodeJoin(nullptr, 0, &request) == Mt7902JoinResult::Invalid);
+    CHECK(mt7902DecodeJoin(wire, sizeof(wire), nullptr) == Mt7902JoinResult::Invalid);
+    puts("Native join decoder passed PMK/PMKSA, BSSID, authentication, length, and truncation checks.");
+}
diff --git a/tests/rsn_test.cpp b/tests/rsn_test.cpp
new file mode 100644
index 0000000..ae8fcb9
--- /dev/null
+++ b/tests/rsn_test.cpp
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+#include "../src/itl_rsn.h"
+#include "../src/itl_replay.h"
+#include "../src/itl_ba.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vector>
+#include "rsn_vectors.h"
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"failed line %d: %s\n",__LINE__,#x); exit(1); } } while (0)
+static const uint8_t rsnIe[]={48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0};
+struct Rig {
+    ItlRsnSession session;
+    bool cancel=false,failM4=false,failGtk=false,deauthOnM4=false,cancelOnInstall=false;
+    unsigned pairwise=0,group=0,clears=0,replies=0,randoms=0;
+    uint64_t rsc=0;
+    std::vector<uint8_t> last;
+    static bool send(void *p,const uint8_t *frame,size_t n,bool protect,bool confirm) {
+        Rig &r=*(Rig*)p; r.last.assign(frame,frame+n);
+        uint16_t info=(uint16_t)(frame[5]<<8|frame[6]);
+        if(info==0x030a){CHECK(confirm);CHECK(!protect);r.replies++; if(r.deauthOnM4)r.cancel=true;return !r.failM4;}
+        if(info==0x0302){CHECK(confirm);CHECK(protect);r.replies++;}
+        return true;
+    }
+    static bool install(void *p,bool pt,uint8_t,const uint8_t *,uint64_t rsc) {
+        Rig &r=*(Rig*)p;if(pt)r.pairwise++;else r.group++;r.rsc=rsc;
+        if(r.cancelOnInstall)r.cancel=true;
+        return pt || !r.failGtk;
+    }
+    static void clear(void *p){((Rig*)p)->clears++;}
+    static bool cancelled(void *p){return ((Rig*)p)->cancel;}
+    static void random(void *p,uint8_t *out,size_t n){Rig &r=*(Rig*)p;memset(out,r.randoms++?0x55:0x22,n);}
+    Rig() {
+        ItlRsnSecurity selected={};CHECK(itl_rsn_select(rsnIe,sizeof(rsnIe),nullptr,0,&selected));
+        ItlRsnOps ops={this,send,install,clear,cancelled,random};uint8_t pmk[32],aa[]={2,3,4,5,6,7},spa[]={8,9,10,11,12,13};memset(pmk,0x11,32);
+        session.start(ops,selected,pmk,aa,spa,1);
+    }
+    void m1(){CHECK(session.receive(fx_m1,sizeof(fx_m1),2));}
+    void joined(){m1();CHECK(session.receive(fx_normal,sizeof(fx_normal),3));CHECK(session.authorized());}
+};
+struct OrderedReplay {
+    ItlReplayKey key;
+    unsigned delivered=0;
+    static void deliver(void *p,const uint8_t *bytes,uint32_t n){auto &r=*(OrderedReplay*)p;CHECK(n==8);uint64_t pn;memcpy(&pn,bytes,8);CHECK(r.key.accept(pn,0,r.key.epoch));r.delivered++;}
+};
+int main(){
+    {Rig r;r.joined();CHECK(r.pairwise==1&&r.group==1&&r.clears==0);}
+    struct Bad{const uint8_t *p;size_t n;};
+    const Bad bad[]={{fx_no_rsn,sizeof(fx_no_rsn)},{fx_changed_rsn,sizeof(fx_changed_rsn)},
+        {fx_no_secure,sizeof(fx_no_secure)},{fx_wrong_keylen,sizeof(fx_wrong_keylen)},
+        {fx_no_gtk,sizeof(fx_no_gtk)},{fx_bad_mic,sizeof(fx_bad_mic)},{fx_bad_nonce,sizeof(fx_bad_nonce)}};
+    for(const auto &b:bad){Rig r;r.m1();CHECK(!r.session.receive(b.p,b.n,3));CHECK(!r.session.authorized());CHECK(!r.pairwise&&!r.group);}
+    {Rig r;r.m1();CHECK(r.session.receive(fx_large,sizeof(fx_large),3));CHECK(r.session.authorized());}
+    {Rig r;r.joined();CHECK(r.session.receive(fx_normal,sizeof(fx_normal),4));CHECK(r.pairwise==1&&r.group==1&&r.replies==2);}
+    {Rig r;r.joined();CHECK(!r.session.receive(fx_m1,sizeof(fx_m1),4));CHECK(r.session.authorized());}
+    {Rig r;r.joined();CHECK(r.session.receive(fx_group,sizeof(fx_group),4));CHECK(r.group==2&&r.pairwise==1);CHECK(r.session.receive(fx_group,sizeof(fx_group),5));CHECK(r.group==2);CHECK(!r.session.receive(fx_oldGroup,sizeof(fx_oldGroup),6));CHECK(!r.session.receive(fx_groupBadMic,sizeof(fx_groupBadMic),6));}
+    {Rig r;r.joined();CHECK(r.session.receive(fx_rekey_m1,sizeof(fx_rekey_m1),10));CHECK(r.session.authorized());CHECK(r.session.receive(fx_rekey_normal,sizeof(fx_rekey_normal),11));CHECK(r.pairwise==2&&r.group==1);CHECK(r.session.receive(fx_rekey_normal,sizeof(fx_rekey_normal),12));CHECK(r.pairwise==2);}
+    {Rig r;r.m1();r.deauthOnM4=true;CHECK(!r.session.receive(fx_normal,sizeof(fx_normal),3));CHECK(!r.session.authorized()&&r.clears==1&&r.pairwise==0);}
+    {Rig r;r.m1();r.failM4=true;CHECK(!r.session.receive(fx_normal,sizeof(fx_normal),3));CHECK(r.clears==1&&!r.pairwise);}
+    {Rig r;r.m1();r.failGtk=true;CHECK(!r.session.receive(fx_normal,sizeof(fx_normal),3));CHECK(r.clears==1&&!r.session.authorized());}
+    {Rig r;r.m1();r.cancelOnInstall=true;CHECK(!r.session.receive(fx_normal,sizeof(fx_normal),3));CHECK(r.clears==1&&r.group==0);}
+    {Rig r;r.m1();r.cancel=true;r.session.tick(3);CHECK(r.session.state()==ItlRsnSession::Failed&&r.clears==1);}
+    {Rig r;r.m1();unsigned sent=r.session.m2Count;r.session.tick(1503);CHECK(r.session.m2Count==sent+1);r.session.tick(6003);CHECK(r.session.state()==ItlRsnSession::Failed);}
+    {Rig r;for(size_t n=0;n<99;n++)CHECK(!r.session.receive(fx_normal,n,2));CHECK(!r.session.authorized());}
+    {ItlRsnSecurity s={};uint8_t changed[sizeof(rsnIe)];memcpy(changed,rsnIe,sizeof(changed));changed[20]=0x40;CHECK(!itl_rsn_select(changed,sizeof(changed),nullptr,0,&s));changed[20]=0;changed[7]=2;CHECK(!itl_rsn_select(changed,sizeof(changed),nullptr,0,&s));CHECK(!itl_rsn_select(rsnIe,sizeof(rsnIe),changed,sizeof(changed),&s));}
+    {ItlReplayKey k;k.install(10);CHECK(!k.accept(10,0,k.epoch));CHECK(k.accept(11,0,k.epoch));CHECK(!k.accept(11,0,k.epoch));CHECK(k.accept(11,1,k.epoch));uint32_t old=k.epoch;k.install(20);CHECK(!k.accept(21,0,old));CHECK(k.accept(21,0,k.epoch));k.clear();CHECK(!k.accept(30,0,k.epoch));}
+    {OrderedReplay r;r.key.install(0);itl_reorder reorder={};itl_ba_slot slots[8]={};itl_reorder_start(&reorder,slots,10,8);uint64_t p11=11,p10=10;itl_reorder_rx(&reorder,11,(const uint8_t*)&p11,8,1,OrderedReplay::deliver,&r);CHECK(!r.delivered);itl_reorder_rx(&reorder,10,(const uint8_t*)&p10,8,2,OrderedReplay::deliver,&r);CHECK(r.delivered==2);}
+    puts("RSN session: validation, replay, retransmission, GTK/PTK rekey, rollback, cancellation, deadlines and PN-after-reorder passed.");
+}
