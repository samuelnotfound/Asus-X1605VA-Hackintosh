new file mode 100644
index 0000000..2030985
--- /dev/null
+++ b/src/itl_rsn.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+// Kernel-independent WPA2-PSK/CCMP station session. Hardware effects are explicit
+// callbacks; a failed transaction closes the port and removes installed keys.
+#pragma once
+#include "itl_wpa.h"
+#include <stdint.h>
+#include <stddef.h>
+
+enum { ITL_RSN_FRAME_MAX = 1536, ITL_RSN_IE_MAX = 257 };
+struct ItlRsnSecurity {
+    uint16_t apLength, stationLength;
+    uint8_t ap[ITL_RSN_IE_MAX], station[ITL_RSN_IE_MAX];
+};
+bool itl_rsn_select(const uint8_t *ap, size_t apLength,
+                    const uint8_t *requested, size_t requestedLength,
+                    ItlRsnSecurity *selected);
+struct ItlRsnOps {
+    void *context;
+    bool (*send)(void *, const uint8_t *, size_t, bool protect, bool confirm);
+    bool (*install)(void *, bool pairwise, uint8_t keyId, const uint8_t key[16], uint64_t rsc);
+    void (*clear)(void *);
+    bool (*cancelled)(void *);
+    void (*random)(void *, uint8_t *, size_t);
+};
+class ItlRsnSession {
+public:
+    enum State { Idle, AwaitM1, AwaitM3, Established, Failed };
+    void start(const ItlRsnOps &, const ItlRsnSecurity &, const uint8_t pmk[32],
+               const uint8_t ap[6], const uint8_t station[6], uint32_t now);
+    bool receive(const uint8_t *, size_t, uint32_t now);
+    void tick(uint32_t now);
+    void reset();
+    State state() const { return phase; }
+    bool authorized() const { return installed && phase != Failed && phase != Idle; }
+    const char *error() const { return failure; }
+    uint32_t m1Count=0, m2Count=0, m3Count=0, groupCount=0, rejects=0;
+private:
+    State phase=Idle;
+    ItlRsnOps ops={};
+    ItlRsnSecurity security={};
+    uint8_t pmk[32]={}, aa[6]={}, spa[6]={}, snonce[32]={}, anonce[32]={}, activeAnonce[32]={};
+    uint8_t pendingReplay[8]={}, acceptedReplay[8]={};
+    bool accepted=false, installed=false, pending=false, lastPairwise=false;
+    itl_ptk candidate={}, active={};
+    uint8_t gtk[4][16]={};
+    bool gtkInstalled[4]={};
+    uint32_t phaseStart=0, lastM2=0;
+    const char *failure="";
+    void fail(const char *);
+    bool cancelled();
+    bool sendM2(uint32_t);
+    bool sendReply(uint16_t info, const uint8_t replay[8], const uint8_t kck[16], bool protect);
+    bool decodeData(const itl_eapol_key &, const itl_ptk &, bool pairwise,
+                    uint8_t key[16], uint8_t *keyId);
+};
