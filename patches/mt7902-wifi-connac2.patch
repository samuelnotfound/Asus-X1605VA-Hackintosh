new file mode 100644
index 0000000..2d901e6
--- /dev/null
+++ b/src/itl_station.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+// Shared, kernel-independent station policy. Rates are in 500 kbit/s units.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+struct ItlLegacyRates { uint8_t cck=0,ofdm=0,basicCck=0,basicOfdm=0; bool inferred=false; };
+inline bool itl_station_rates(const uint8_t *ies,size_t length,bool band2,ItlLegacyRates *out) {
+    *out={};
+    static const uint8_t cck[]={2,4,11,22},ofdm[]={12,18,24,36,48,72,96,108};
+    for(size_t off=0;off<length;) {
+        if(length-off<2 || ies[off+1]+2u>length-off) return false;
+        unsigned id=ies[off],n=ies[off+1];
+        if(id==1 || id==50) for(unsigned j=0;j<n;j++) {
+            uint8_t rate=ies[off+2+j],v=rate&127;
+            for(unsigned k=0;band2 && k<4;k++) if(v==cck[k]) {out->cck|=1u<<k;if(rate&128)out->basicCck|=1u<<k;}
+            for(unsigned k=0;k<8;k++) if(v==ofdm[k]) {out->ofdm|=1u<<k;if(rate&128)out->basicOfdm|=1u<<k;}
+        }
+        off+=2+n;
+    }
+    if(!out->cck && !out->ofdm) return false;
+    if(!out->basicCck && !out->basicOfdm) {
+        // Some HT-only APs omit every Basic bit. Never send a zero basic mask
+        // to firmware, or invent a CCK rate that the AP did not advertise.
+        out->inferred=true;
+        if(out->cck)out->basicCck=(uint8_t)(out->cck & -out->cck);
+        else out->basicOfdm=(uint8_t)(out->ofdm & -out->ofdm);
+    }
+    return true;
+}
+inline size_t itl_station_rate_ies(uint8_t *out,const ItlLegacyRates &r) {
+    static const uint8_t cck[]={2,4,11,22},ofdm[]={12,18,24,36,48,72,96,108};
+    uint8_t rates[12]; unsigned n=0;
+    for(unsigned i=0;i<4;i++)if(r.cck&(1u<<i))rates[n++]=cck[i]|((r.basicCck&(1u<<i))?128:0);
+    for(unsigned i=0;i<8;i++)if(r.ofdm&(1u<<i))rates[n++]=ofdm[i]|((r.basicOfdm&(1u<<i))?128:0);
+    if(!n)return 0;
+    unsigned first=n<8?n:8;out[0]=1;out[1]=(uint8_t)first;
+    for(unsigned i=0;i<first;i++)out[2+i]=rates[i];
+    if(n<=8)return 2+n;
+    out[10]=50;out[11]=(uint8_t)(n-8);for(unsigned i=8;i<n;i++)out[4+i]=rates[i];return 4+n;
+}
+struct ItlDataTxPlan { bool qos,rateAdapt; uint8_t queue; };
+inline ItlDataTxPlan itl_station_data_tx(bool negotiatedWmm,bool ht,bool linked,uint16_t type) {
+    const bool ordinary=type!=0x888e;
+    // To-DS broadcast DHCP still has the AP as its unicast receiver. The
+    // ordinary AC_BE queue applies to legacy data as well as HT data.
+    return {ordinary&&negotiatedWmm,ordinary&&ht&&linked,(uint8_t)(ordinary?1:16)};
+}
+inline size_t itl_station_to_ds(uint8_t *out,size_t capacity,const uint8_t ap[6],const uint8_t station[6],
+                               const uint8_t destination[6],uint16_t type,const uint8_t *payload,size_t length,
+                               bool qos,bool protect) {
+    size_t header=qos?26:24,total=header+8+length;
+    if(length>1536 || total>capacity || (length && !payload))return 0;
+    memset(out,0,header);out[0]=qos?0x88:0x08;out[1]=protect?0x41:0x01;
+    memcpy(out+4,ap,6);memcpy(out+10,station,6);memcpy(out+16,destination,6);
+    static const uint8_t snap[]={0xaa,0xaa,3,0,0,0};memcpy(out+header,snap,6);
+    out[header+6]=(uint8_t)(type>>8);out[header+7]=(uint8_t)type;
+    if(length)memcpy(out+header+8,payload,length);return total;
+}
