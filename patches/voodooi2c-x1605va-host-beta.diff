+IOReturn VoodooI2CControllerDriver::startHostTransport() {
+    if (!host_poll_eligible)
+        return startI2CInterrupt();
+    if (host_poll_timer)
+        return kIOReturnSuccess;
+
+    auto* pci = nub->controller->physical_device.pci_device;
+    bool already_owned = is_interrupt_registered;
+    IOReturn result = startI2CInterrupt();
+    pci->setProperty("X1605VA-I2C1-IRQ-Result", static_cast<UInt32>(result), 32);
+    pci->setProperty("X1605VA-I2C1-IRQ-AlreadyOwned", already_owned ? kOSBooleanTrue : kOSBooleanFalse);
+    if (result == kIOReturnSuccess || already_owned) {
+        pci->setProperty("X1605VA-I2C1-Host-Mode", "interrupt");
+        return kIOReturnSuccess;
+    }
+
+    auto* timer = IOTimerEventSource::timerEventSource(this, pollHostTransfer);
+    if (!timer || work_loop->addEventSource(timer) != kIOReturnSuccess) {
+        OSSafeReleaseNULL(timer);
+        pci->setProperty("X1605VA-I2C1-Host-Mode", "poll-timer-failed");
+        return kIOReturnNoResources;
+    }
+
+    writeRegister(0, DW_IC_INTR_MASK);
+    host_poll_timer = timer;
+    pci->setProperty("X1605VA-I2C1-Host-Mode", "polling");
+    return kIOReturnSuccess;
+}
